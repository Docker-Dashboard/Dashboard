{
  "name": "dashboard",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "engines" : { 
    "pnpm" : ">=12.0.0 <13.0.0",
    "npm" : "please-use-pnpm",
    "node" : ">=24.0.0 <26.0.0"
  },
  "scripts": {
    "predev": "node -e \"if (!process.env.npm_config_user_agent.startsWith('pnpm')) { console.error('\\x1b[31m%s\\x1b[0m', 'Please use pnpm.'); process.exit(1); }\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.31",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
}
