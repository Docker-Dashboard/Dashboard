{
  "name": "dashboard",
  "description": "A custom dashboard for all of your self-hosted apps!",
  "version": "1.1.0",
  "private": true,
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Docker-Dashboard/Dashboard.git"
  },
  "homepage": "https://github.com/Docker-Dashboard/Dashboard",
  "bugs": {
    "url": "https://github.com/Docker-Dashboard/Dashboard/issues"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "pnpm": ">=12.0.0 <13.0.0",
    "npm": "please-use-pnpm",
    "node": ">=26.0.0 <27.0.0"
  },
  "scripts": {
    "predev": "node -e \"if (!process.env.npm_config_user_agent.startsWith('pnpm')) { console.error('\\x1b[31m%s\\x1b[0m', 'Please use pnpm.'); process.exit(1); }\"",
    "dev": "next dev",
    "prebuild": "node -e \"if (!process.env.npm_config_user_agent.startsWith('pnpm')) { console.error('\\x1b[31m%s\\x1b[0m', 'Please use pnpm.'); process.exit(1); }\"",
    "build": "next build",
    "prestart": "node -e \"if (!process.env.npm_config_user_agent.startsWith('pnpm')) { console.error('\\x1b[31m%s\\x1b[0m', 'Please use pnpm.'); process.exit(1); }\"",
    "start": "next start",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/turbopack": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  }
}
